index 0000000..66990d7
--- /dev/null
+++ b/uefidoom/efi/i_hdasound.c
@@ -0,0 +1,290 @@
+// Digital sound effects through AudioDxe's EFI_AUDIO_IO_PROTOCOL.
+//
+// The protocol plays one buffer at a time: the driver copies it into its DMA
+// ring block by block from a poll timer and calls back when the buffer is
+// exhausted. So we hand it one long buffer and keep mixing into it a couple
+// of blocks ahead of where the DMA is (estimated from time), which gives
+// gapless sound with roughly 4 blocks (~90 ms) of latency. The stream is
+// started when an effect starts and stopped after a second of silence.
+//
+// The mixer itself is the classic one: up to MIX_CHANNELS of Doom's 8-bit
+// 11025 Hz effects, each with left/right volume from the separation and a
+// pitch step, summed into 16-bit stereo at 44.1 kHz (4x, linear
+// interpolation) and clamped.
+
+#include <stdio.h>
+#include <string.h>
+
+#include <Uefi.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+
+#include "doomdef.h"
+#include "doomtype.h"
+#include "sounds.h"
+#include "w_wad.h"
+#include "z_zone.h"
+#include "i_system.h"
+#include "i_sound.h"
+#include "i_hdasound.h"
+
+#define OUT_RATE        44100
+#define MIX_CHANNELS    16
+#define BLOCK_FRAMES    1024          // AudioDxe copies 4 KB blocks = 1024 stereo frames
+#define LEAD_BLOCKS     2             // keep this much mixed ahead of the DMA
+#define SRC_SECONDS     8             // buffer handed to the driver; restarted when used up
+#define SRC_FRAMES      (OUT_RATE * SRC_SECONDS)
+#define SILENCE_MS      1000          // stop the stream after this much silence
+
+typedef struct {
+	int           handle;         // 0 = free
+	const byte   *data;           // 8-bit unsigned samples
+	unsigned      length;         // in samples
+	unsigned      pos;            // 16.16 sample position
+	unsigned      step;           // 16.16 samples per output frame
+	int           lvol, rvol;     // 0..127
+} mixchan_t;
+
+static EFI_AUDIO_IO_PROTOCOL *audio;
+static UINT8    output;
+static INT16   *src;              // SRC_FRAMES * 2
+static mixchan_t chan[MIX_CHANNELS];
+static int      nextHandle = 1;
+
+static boolean  running;          // a StartPlaybackAsync is in flight
+static volatile boolean streamDone;  // set by the driver's callback
+static UINT64   startMs;          // when the current buffer was started
+static unsigned writePos;         // frames mixed into src so far
+static UINT64   lastActiveMs;
+
+static const byte *sfxData[NUMSFX];
+static unsigned    sfxLen[NUMSFX];
+
+static VOID EFIAPI StreamCallback(EFI_AUDIO_IO_PROTOCOL *AudioIo, VOID *Context)
+{
+	streamDone = true;
+}
+
+boolean I_HDA_Init(EFI_AUDIO_IO_PROTOCOL *audioIo, UINT8 outputIndex)
+{
+	EFI_STATUS st;
+	audio = audioIo;
+	output = outputIndex;
+	src = (INT16 *)Z_Malloc(SRC_FRAMES * 2 * sizeof(INT16), PU_STATIC, 0);
+	if (!src)
+		return false;
+	st = audio->SetupPlayback(audio, output, 80, EfiAudioIoFreq44kHz, EfiAudioIoBits16, 2);
+	if (EFI_ERROR(st)) {
+		printf("HDA: SetupPlayback failed: 0x%llx\n", (unsigned long long)st);
+		audio = NULL;
+		return false;
+	}
+	printf("HDA: digital sound on output %d (44.1 kHz 16-bit stereo)\n", outputIndex);
+	return true;
+}
+
+static const byte *LoadSfx(int id, unsigned *len)
+{
+	sfxinfo_t *sfx = &S_sfx[id];
+	int lump;
+	const byte *lumpdata;
+	unsigned lumplen;
+	if (sfx->link)
+		sfx = sfx->link;
+	if (sfxData[id]) {
+		*len = sfxLen[id];
+		return sfxData[id];
+	}
+	lump = I_GetSfxLumpNum(sfx);
+	if (lump < 0)
+		return NULL;
+	lumplen = W_LumpLength(lump);
+	if (lumplen <= 8)
+		return NULL;
+	lumpdata = W_CacheLumpNum(lump, PU_STATIC);
+	// DS lump: u16 format (3), u16 rate, u32 sample count, then samples.
+	sfxData[id] = lumpdata + 8;
+	sfxLen[id] = lumplen - 8;
+	*len = sfxLen[id];
+	return sfxData[id];
+}
+
+static void SetVolume(mixchan_t *c, int vol, int sep)
+{
+	// vanilla i_sound.c addsfx(): vol is 0..15, separation 0..255
+	int s = sep + 1;
+	vol *= 8;
+	c->lvol = vol - ((vol * s * s) >> 16);
+	s -= 257;
+	c->rvol = vol - ((vol * s * s) >> 16);
+	if (c->lvol < 0) c->lvol = 0;
+	if (c->rvol < 0) c->rvol = 0;
+}
+
+// 11025/44100 = 1/4 sample per frame, scaled by pitch (128 = normal).
+static unsigned PitchStep(int pitch)
+{
+	if (pitch < 1) pitch = 1;
+	return (unsigned)pitch * 128;   // (65536 / 4) * pitch / 128
+}
+
+int I_HDA_StartSound(int sfx_id, int vol, int sep, int pitch)
+{
+	mixchan_t *c = NULL;
+	unsigned len;
+	const byte *data;
+	int i;
+	if (!audio || vol <= 0 || sfx_id <= 0 || sfx_id >= NUMSFX)
+		return 0;
+	data = LoadSfx(sfx_id, &len);
+	if (!data)
+		return 0;
+	for (i = 0; i < MIX_CHANNELS; i++)
+		if (!chan[i].handle) { c = &chan[i]; break; }
+	if (!c) {   // all busy: take the one furthest along
+		unsigned best = 0;
+		for (i = 0; i < MIX_CHANNELS; i++) {
+			unsigned frac = (chan[i].pos >> 16) * 1000 / (chan[i].length ? chan[i].length : 1);
+			if (!c || frac > best) { c = &chan[i]; best = frac; }
+		}
+	}
+	c->data = data;
+	c->length = len;
+	c->pos = 0;
+	c->step = PitchStep(pitch);
+	SetVolume(c, vol, sep);
+	c->handle = nextHandle++;
+	if (nextHandle <= 0)
+		nextHandle = 1;
+	lastActiveMs = I_GetTimeMs();
+	I_HDA_Update();   // get it into the stream right away
+	return c->handle;
+}
+
+static mixchan_t *Find(int handle)
+{
+	int i;
+	if (handle <= 0) return NULL;
+	for (i = 0; i < MIX_CHANNELS; i++)
+		if (chan[i].handle == handle) return &chan[i];
+	return NULL;
+}
+
+void I_HDA_UpdateSoundParams(int handle, int vol, int sep, int pitch)
+{
+	mixchan_t *c = Find(handle);
+	if (!c) return;
+	SetVolume(c, vol, sep);
+	c->step = PitchStep(pitch);
+}
+
+void I_HDA_StopSound(int handle)
+{
+	mixchan_t *c = Find(handle);
+	if (c) c->handle = 0;
+}
+
+int I_HDA_SoundIsPlaying(int handle)
+{
+	return Find(handle) != NULL;
+}
+
+static boolean AnyActive(void)
+{
+	int i;
+	for (i = 0; i < MIX_CHANNELS; i++)
+		if (chan[i].handle) return true;
+	return false;
+}
+
+// Mix n frames into src at frame offset at.
+static void Mix(unsigned at, unsigned n)
+{
+	INT16 *out = src + (UINTN)at * 2;
+	unsigned f;
+	int i;
+	for (f = 0; f < n; f++) {
+		int l = 0, r = 0;
+		for (i = 0; i < MIX_CHANNELS; i++) {
+			mixchan_t *c = &chan[i];
+			unsigned idx, frac;
+			int s0, s1, s;
+			if (!c->handle) continue;
+			idx = c->pos >> 16;
+			if (idx + 1 >= c->length) { c->handle = 0; continue; }
+			frac = c->pos & 0xffff;
+			s0 = (int)c->data[idx] - 128;
+			s1 = (int)c->data[idx + 1] - 128;
+			s = s0 + (((s1 - s0) * (int)frac) >> 16);   // -128..127
+			l += s * c->lvol;                            // up to +-16256
+			r += s * c->rvol;
+			c->pos += c->step;
+		}
+		l <<= 1; r <<= 1;
+		if (l > 32767) l = 32767; else if (l < -32768) l = -32768;
+		if (r > 32767) r = 32767; else if (r < -32768) r = -32768;
+		*out++ = (INT16)l;
+		*out++ = (INT16)r;
+	}
+}
+
+static void Start(void)
+{
+	EFI_STATUS st;
+	writePos = 0;
+	Mix(0, BLOCK_FRAMES * (LEAD_BLOCKS + 1));
+	writePos = BLOCK_FRAMES * (LEAD_BLOCKS + 1);
+	streamDone = false;
+	st = audio->StartPlaybackAsync(audio, src, (UINTN)SRC_FRAMES * 4, 0, StreamCallback, NULL);
+	if (EFI_ERROR(st)) {
+		static boolean reported;
+		if (!reported) { reported = true; printf("HDA: StartPlaybackAsync failed: 0x%llx\n", (unsigned long long)st); }
+		return;
+	}
+	startMs = I_GetTimeMs();
+	running = true;
+}
+
+void I_HDA_Update(void)
+{
+	UINT64 now;
+	unsigned consumed, target;
+	if (!audio)
+		return;
+	now = I_GetTimeMs();
+	if (AnyActive())
+		lastActiveMs = now;
+
+	if (streamDone) {           // the driver used up the whole buffer
+		streamDone = false;
+		running = false;
+	}
+	if (!running) {
+		if (AnyActive())
+			Start();
+		return;
+	}
+	if (!AnyActive() && now - lastActiveMs > SILENCE_MS) {
+		audio->StopPlayback(audio);
+		running = false;
+		return;
+	}
+	// Frames the driver has copied so far: 2 blocks up front, then one block
+	// each time a block finishes playing.
+	consumed = (unsigned)((now - startMs) * OUT_RATE / 1000) + 2 * BLOCK_FRAMES;
+	target = consumed + LEAD_BLOCKS * BLOCK_FRAMES;
+	if (target > SRC_FRAMES)
+		target = SRC_FRAMES;
+	if (writePos < target) {
+		Mix(writePos, target - writePos);
+		writePos = target;
+	}
+}
+
+void I_HDA_Shutdown(void)
+{
+	if (audio && running)
+		audio->StopPlayback(audio);
+	running = false;
+	audio = NULL;
+}
