+// Expand each 320-pixel line once, then copy it frameScale times straight
+// into the framebuffer: sequential 64-bit writes, which write-combined
+// framebuffers like; never read it back.
+void FbRender(void)
+{
+	byte* src = screens[0];
+	UINT32* dst = fbBase + (UINTN)frameTop * fbStride + frameLeft;
+	UINTN x, y, k;
+	for (y = 0; y < SCREENHEIGHT; y++)
+	{
+		UINT32* lp = lineBuf;
+		for (x = 0; x < SCREENWIDTH; x++)
+		{
+			UINT32 c = gPalette32[*src++];
+			for (k = 0; k < frameScale; k++)
+				*lp++ = c;
+		}
+		for (k = 0; k < frameScale; k++)
+		{
+			CopyMem(dst, lineBuf, (UINTN)frameWidth * 4);
+			dst += fbStride;
+		}
+	}
+}
+
+const char* I_VideoPath(void)
+{
+	return fbDirect ? "fb" : "blt";
+}
+
+int I_MouseResolution(void)
+{
+	return gMouseProtocol ? (int)gMouseProtocol->Mode->ResolutionX : -1;
+}
+
+int I_MousePeak(void)
+{
+	int p = mousePeak;
+	mousePeak = 0;
+	return p;
+}
