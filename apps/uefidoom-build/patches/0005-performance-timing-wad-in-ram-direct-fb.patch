+// -fps: once a second, put frames/s, ms per frame, the drawing path, and the
+// mouse resolution and peak movement the firmware reports (for calibrating
+// -mousescale) in the HUD message line.
+static boolean showfps;
+static char fpsmsg[96];
+
+static void D_FrameStats(void)
+{
+	static unsigned long long last;
+	static int frames;
+	unsigned long long now;
+
+	if (!showfps)
+		return;
+	frames++;
+	now = I_GetTimeMs();
+	if (now - last < 1000)
+		return;
+	if (last)
+	{
+		// keep it short: the HUD line is 320 pixels wide
+		sprintf(fpsmsg, "%dfps %dms %s res %d pk %d", frames,
+		        (int)((now - last) / frames), I_VideoPath(), I_MouseResolution(), I_MousePeak());
+		players[consoleplayer].message = fpsmsg;
+	}
+	last = now;
+	frames = 0;
+}
