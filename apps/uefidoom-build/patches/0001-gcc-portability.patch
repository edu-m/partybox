Portability fixes for building uefidoom with GCC:
 - declare G_ResetKeycmd and I_Error where they are used (no implicit decls)
 - EFIAPI on the audio callback and ShellAppMain prototype (MS ABI; only
   identical by accident under MSVC)
 - explicit casts for intentional pointer-type conversions

diff --git a/uefidoom/efi/i_sound.c b/uefidoom/efi/i_sound.c
index fa61459..827c3db 100644
--- a/uefidoom/efi/i_sound.c
+++ b/uefidoom/efi/i_sound.c
@@ -247,7 +247,7 @@ getsfx(char *sfxname,
 }
 UINTN SoundPlaybackHandles = 0;
 char* calldata = {0};
-void I_FinishedSound(IN EFI_AUDIO_IO_PROTOCOL *AudioIo, IN VOID *Context)
+VOID EFIAPI I_FinishedSound(IN EFI_AUDIO_IO_PROTOCOL *AudioIo, IN VOID *Context)
 {
 
 }
@@ -285,7 +285,7 @@ int I_StartSound(int id,
         if (EFI_ERROR(res)) audioIo->SetupPlayback(audioIo, outputToUse, realvol, EfiAudioIoFreq44kHz, EfiAudioIoBits16, 2);
         if (sndsfxLength[id] == 0)
         {
-            src_short_to_float_array(sampdata,floatsounddata,sampLength / sizeof(short));
+            src_short_to_float_array((const short *)sampdata,floatsounddata,sampLength / sizeof(short));
             SRC_DATA data;
             memset(&data,0,sizeof(SRC_DATA));
             data.data_in = floatsounddata;
