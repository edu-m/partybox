+#ifndef I_PCSPEAKER_H
+#define I_PCSPEAKER_H
+
+// PC speaker sound effects (the IWAD's DP* lumps) via the 8254 timer.
+void I_PCS_Init (void);
+int  I_PCS_StartSound (int sfx_id, int vol, int priority);  // handle, 0 = not started
+void I_PCS_StopSound (int handle);
+int  I_PCS_SoundIsPlaying (int handle);
+void I_PCS_Update (void);     // call often (every frame and while waiting for a tic)
+void I_PCS_Shutdown (void);   // silence; safe to call any time
+
+#endif
