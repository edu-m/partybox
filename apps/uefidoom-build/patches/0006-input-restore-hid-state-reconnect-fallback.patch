+		// Remember how the firmware left the device, so it gets it back that
+		// way: a driver using the report protocol or periodic idle reports
+		// would otherwise read garbage after we exit.
+		k->HaveProtocol = !EFI_ERROR(HidRequest(k, 0x80, 0x03, 0, &k->Protocol, 1));   // GET_PROTOCOL
+		k->HaveIdle = !EFI_ERROR(HidRequest(k, 0x80, 0x02, 0, &k->Idle, 1));           // GET_IDLE
+		HidRequest(k, 0, 0x0B, 0, NULL, 0);        // SET_PROTOCOL: boot
+		HidRequest(k, 0, 0x0A, 0, NULL, 0);        // SET_IDLE: report on change only
+
 		if (EFI_ERROR(io->UsbAsyncInterruptTransfer(io, ep, TRUE, interval, 8, UsbKbdCallback,
 		                                            (VOID *)(UINTN)numUsbKbd))) {
+			if (k->HaveProtocol) HidRequest(k, 0, 0x0B, k->Protocol, NULL, 0);
+			if (k->HaveIdle) HidRequest(k, 0, 0x0A, (UINT16)k->Idle << 8, NULL, 0);
 			gBS->ConnectController(handles[i], NULL, NULL, TRUE);   // give it back
 			continue;
 		}
-		k->Handle = handles[i];
-		k->UsbIo = io;
-		k->Endpoint = ep;
 		numUsbKbd++;
 	}
 	gBS->FreePool(handles);
@@ -221,11 +267,19 @@ static void UsbPoll(void)
 
 static void UsbRelease(void)
 {
+	boolean missing = false;
 	for (int i = 0; i < numUsbKbd; i++) {
 		USB_KBD *k = &usbKbd[i];
 		k->UsbIo->UsbAsyncInterruptTransfer(k->UsbIo, k->Endpoint, FALSE, 0, 0, NULL, NULL);
+		gBS->Stall(2000);   // let the host controller retire the transfer
+		if (k->HaveProtocol) HidRequest(k, 0, 0x0B, k->Protocol, NULL, 0);
+		if (k->HaveIdle) HidRequest(k, 0, 0x0A, (UINT16)k->Idle << 8, NULL, 0);
 		gBS->ConnectController(k->Handle, NULL, NULL, TRUE);
+		if (!HasTextInput(k->Handle))
+			missing = true;
 	}
+	if (missing)
+		ConnectAll();
 	numUsbKbd = 0;
