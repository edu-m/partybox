Input: hand USB keyboards back the way the firmware left them.
 - remember the HID protocol and idle rate (GET_PROTOCOL / GET_IDLE) before
   switching to boot protocol, restore both at exit: a firmware driver using
   the report protocol or periodic idle reports read garbage afterwards,
   leaving the UEFI Shell without a keyboard on some boards
 - only take over a device whose firmware driver was actually detached
   (DisconnectController succeeded); let the host controller retire the
   cancelled transfer before reconnecting
 - if a reconnect does not bring text input back on the handle, connect all
   handles (what the shell's "connect -r" does)

diff --git a/uefidoom/efi/i_input.c b/uefidoom/efi/i_input.c
index 02a69ed..ad6f42d 100644
--- a/uefidoom/efi/i_input.c
+++ b/uefidoom/efi/i_input.c
@@ -31,6 +31,7 @@
 #include <Protocol/UsbIo.h>
 #include <Protocol/DevicePath.h>
 #include <Protocol/SimpleTextIn.h>
+#include <Protocol/SimpleTextInEx.h>
 
 #include "doomdef.h"
 #include "d_event.h"
@@ -67,9 +68,50 @@ typedef struct {
 	EFI_HANDLE           Handle;
 	EFI_USB_IO_PROTOCOL *UsbIo;
 	UINT8                Endpoint;
+	UINT8                Interface;
+	UINT8                Protocol;    // HID protocol before we touched it (1 = report)
+	UINT8                Idle;        // idle rate before we touched it
+	boolean              HaveProtocol, HaveIdle;
 	UINT8                Prev[8];
 } USB_KBD;
 
+// HID class requests on the keyboard interface.
+static EFI_STATUS HidRequest(USB_KBD *k, UINT8 dir, UINT8 request, UINT16 value, VOID *data, UINT16 len)
+{
+	EFI_USB_DEVICE_REQUEST req;
+	UINT32 usbStatus;
+	ZeroMem(&req, sizeof(req));
+	req.RequestType = 0x21 | dir;   // class, interface; dir 0x80 = device-to-host
+	req.Request = request;
+	req.Value = value;
+	req.Index = k->Interface;
+	req.Length = len;
+	return k->UsbIo->UsbControlTransfer(k->UsbIo, &req, len ? (dir ? EfiUsbDataIn : EfiUsbDataOut) : EfiUsbNoData,
+	                                    100, data, len, &usbStatus);
+}
+
+// Does the handle offer text input again (i.e. has the firmware's keyboard
+// driver come back)?
+static boolean HasTextInput(EFI_HANDLE h)
+{
+	VOID *p;
+	return !EFI_ERROR(gBS->HandleProtocol(h, &gEfiSimpleTextInProtocolGuid, &p)) ||
+	       !EFI_ERROR(gBS->HandleProtocol(h, &gEfiSimpleTextInputExProtocolGuid, &p));
+}
+
+// Last resort when a reconnect doesn't bring a keyboard back: connect every
+// handle in the system, like the shell's `connect -r`.
+static void ConnectAll(void)
+{
+	EFI_HANDLE *handles = NULL;
+	UINTN count = 0;
+	if (EFI_ERROR(gBS->LocateHandleBuffer(AllHandles, NULL, NULL, &count, &handles)))
+		return;
+	for (UINTN i = 0; i < count; i++)
+		gBS->ConnectController(handles[i], NULL, NULL, TRUE);
+	gBS->FreePool(handles);
+}
+
 static USB_KBD usbKbd[MAX_USB_KBD];
 static int     numUsbKbd;
 
