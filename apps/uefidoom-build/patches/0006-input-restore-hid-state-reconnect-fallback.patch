 		if (!ep)
 			continue;
 
-		// Detach the firmware's keyboard driver, then talk to the device.
-		gBS->DisconnectController(handles[i], NULL, NULL);
-
-		UINT32 usbStatus;
-		EFI_USB_DEVICE_REQUEST req;
-		ZeroMem(&req, sizeof(req));
-		req.RequestType = 0x21;   // class, interface, host-to-device
-		req.Index = ifd.InterfaceNumber;
-		req.Request = 0x0B;       // SET_PROTOCOL: boot
-		io->UsbControlTransfer(io, &req, EfiUsbNoData, 100, NULL, 0, &usbStatus);
-		req.Request = 0x0A;       // SET_IDLE: report on change only
-		io->UsbControlTransfer(io, &req, EfiUsbNoData, 100, NULL, 0, &usbStatus);
+		// Detach the firmware's keyboard driver. If that doesn't work, leave
+		// the device alone: two readers on one endpoint would break both.
+		if (EFI_ERROR(gBS->DisconnectController(handles[i], NULL, NULL)))
+			continue;
 
 		USB_KBD *k = &usbKbd[numUsbKbd];
 		ZeroMem(k, sizeof(*k));
+		k->Handle = handles[i];
+		k->UsbIo = io;
+		k->Endpoint = ep;
+		k->Interface = ifd.InterfaceNumber;
